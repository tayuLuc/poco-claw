# Poco-Claw .env — Podman on Mac
# Copy to .env and fill in

# ─── API Keys (required) ─────────────────────
# OpenCode Go subscription key (get from opencode.ai/auth)
OC_GO_CC_API_KEY=sk-...
# OPENAI_API_KEY — only for mem0 (optional)
# ANTHROPIC_API_KEY — if using Anthropic directly (not via OpenCode Go)

# ─── Database ────────────────────────────────
POSTGRES_USER=poco
POSTGRES_PASSWORD=poco_secret
POSTGRES_DB=poco
POSTGRES_PORT=5432

# ─── S3 (RustFS built-in) ────────────────────
S3_ROOT_USER=minioadmin
S3_ROOT_PASSWORD=minioadmin
S3_BUCKET=poco-workspace
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ─── Reverse Proxy (Caddy) ───────────────────
# Only port exposed externally (frontend + API)
# CADDY_PORT=8080

# ─── Backend ─────────────────────────────────
# BACKEND_PORT=8000 — internal network only, through Caddy
LOG_LEVEL=INFO

# ─── Executor Manager ────────────────────────
EXECUTOR_MANAGER_PORT=8001
EXECUTOR_IMAGE=ghcr.io/poco-ai/sandbox:lite
EXECUTOR_BROWSER_IMAGE=ghcr.io/poco-ai/sandbox:full

# ─── Frontend ────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── OpenCode Go (via oc-go-cc proxy) ────────
# Default model for poco-claw
DEFAULT_MODEL=deepseek-v4-flash
# Proxy port
OC_GO_CC_PORT=3456
# OpenCode Go API endpoint
# OC_GO_CC_OPENCODE_URL=https://opencode.ai/zen/go/v1/chat/completions
# Proxy log level
# OC_GO_CC_LOG_LEVEL=info

# ─── Podman (Mac) ────────────────────────────
# rootless: your user UID in Podman Machine
PODMAN_UID=1000
# If socket is elsewhere — specify explicitly
# DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
# DOCKER_SOCK=/run/user/1000/podman/podman.sock

# ─── Mem0 (optional) ─────────────────────────
# MEM0_POSTGRES_USER=mem0
# MEM0_POSTGRES_PASSWORD=mem0_secret
# MEM0_POSTGRES_DB=mem0
# MEM0_POSTGRES_EXPOSE_PORT=5433
# MEM0_NEO4J_PASSWORD=mem0_neo4j_secret
